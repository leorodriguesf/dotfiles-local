#!/usr/bin/env bash
# Decrypt committed files that are marked in .vaultfiles

# Function to match files against gitignore-style patterns
match_pattern() {
    local file="$1"
    local pattern="$2"
    
    # Skip empty patterns or comments
    [[ -z "$pattern" || "$pattern" =~ ^[[:space:]]*# ]] && return 1
    
    
    # Normalize paths (remove leading ./ and trailing /)
    file="${file#./}"
    pattern="${pattern#./}"
    pattern="${pattern%/}"
    
    local match=false
    
    # Handle different pattern types
    if [[ "$pattern" == *"**"* ]]; then
        # Convert ** patterns to proper glob patterns
        # Replace ** with * for bash pattern matching
        local bash_pattern="${pattern//\*\*/\*}"
        
        # Check if pattern contains /**/ (recursive directory match)
        if [[ "$pattern" == *"/**/"* ]]; then
            # For patterns like "dir/**/file", match anywhere in the path
            local prefix="${pattern%%/**/*}"
            local suffix="${pattern##*/**/}"
            
            if [[ -n "$prefix" && -n "$suffix" ]]; then
                [[ "$file" == "$prefix"*"$suffix"* ]] && match=true
            elif [[ -n "$prefix" ]]; then
                [[ "$file" == "$prefix"/* ]] && match=true
            elif [[ -n "$suffix" ]]; then
                [[ "$file" == *"$suffix" ]] && match=true
            fi
        else
            # Simple ** at end (like dir/**)
            local base_pattern="${pattern%/**}"
            [[ "$file" == "$base_pattern"* ]] && match=true
        fi
    else
        # Regular glob pattern matching
        [[ "$file" == $pattern ]] && match=true
        
        # Also check if it matches as a directory pattern
        [[ "$file" == "$pattern"/* ]] && match=true
    fi
    
    # Return result
    [[ "$match" == true ]] && return 0 || return 1
}

# Function to check if a file matches any pattern in .vaultfiles
file_matches_vaultfiles() {
    local file="$1"
    local matched=false
    
    # Read patterns from .vaultfiles
    while IFS= read -r pattern; do
        # Skip empty lines
        [[ -z "$pattern" ]] && continue
        
        if match_pattern "$file" "$pattern"; then
            matched=true
            break  # Found a match, no need to check other patterns
        fi
    done < .vaultfiles
    
    [[ "$matched" == true ]]
}

# Check which files were just committed
COMMITTED_FILES=$(git diff --name-only HEAD~1 HEAD)

# Collect files that need decryption
FILES_TO_DECRYPT=()

# Check each committed file against vault patterns
while IFS= read -r committed_file; do
    [[ -z "$committed_file" ]] && continue
    
    if file_matches_vaultfiles "$committed_file"; then
        # Only decrypt if currently encrypted
        if [ -f "$committed_file" ] && grep -q '^\$ANSIBLE_VAULT;' "$committed_file"; then
            FILES_TO_DECRYPT+=("$committed_file")
        fi
    fi
done <<< "$COMMITTED_FILES"

if [ ${#FILES_TO_DECRYPT[@]} -gt 0 ]; then
  echo "Decrypting: ${FILES_TO_DECRYPT[*]}"

  # If file includes ssh/ in the path, ask for vault password
  if [[ "${FILES_TO_DECRYPT[@]}" =~ "ssh/" ]]; then
    ansible-vault decrypt "${FILES_TO_DECRYPT[@]}" --ask-vault-pass
  else
    ansible-vault decrypt "${FILES_TO_DECRYPT[@]}" --vault-password-file <(vault-from-op)
  fi

  # No need to re-stage since this is post-commit - files are decrypted in working directory
else
  echo "No files needed decryption"
fi