#!/usr/bin/env bash
# Encrypt only staged files that are marked in .gitattributes

# Get the list of files tracked by ansible-vault filter
VAULT_FILES=$(awk '$2 ~ /^filter=ansible-vault/ {print $1}' .gitattributes)

# Check which of these files are staged
STAGED_FILES=$(git diff --cached --name-only)

# Encrypt only staged vault files
for f in $VAULT_FILES; do
  # Is this vault file staged?
  if echo "$STAGED_FILES" | grep -qx "$f"; then
    # Only encrypt if not already encrypted
    if [ -f "$f" ] && ! grep -q '^\$ANSIBLE_VAULT;' "$f"; then
      echo "Encrypting $f..."
      ansible-vault encrypt "$f"
      git add "$f"  # re-stage the encrypted version
    fi
  fi
done